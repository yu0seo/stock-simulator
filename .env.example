# Copy to .env in the repository root. Never put server keys in VITE_* variables.
APP_NAME=대가 API
FRONTEND_URL=http://localhost:5173
AUTH_MODE=auto
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENDART_API_KEY=
INITIAL_CAPITAL=10000000
GAME_YEAR=2024
STAGE_MINUTES=30
# Enable the last-day / settlement shortcuts during local debugging.
ENABLE_DEBUG_TOOLS=false
# JSON array: repayment for stages 1 through 12, in KRW.
STAGE_PAYMENTS=[500000,600000,700000,800000,900000,1000000,1100000,1200000,1300000,1400000,1500000,1600000]
